{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto"
    },
    "display": {
        "separator": "",
        "key": {
            "width": 10
        }
    },
    "modules": [
        "title",
        "separator",
        // Hardware
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "disk",
            "key": "Disk"
        },
        "separator",
        // Linux
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        "separator",
        // Desktop Environment
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wmtheme",
            "key": "WM Theme"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        "separator",
        "colors"
    ]
}